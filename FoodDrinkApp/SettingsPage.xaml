<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Frame CornerRadius="10" Padding="15">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Dark Mode" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Toggle application dark theme" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
                <Switch x:Name="ThemeSwitch" Grid.Column="1" Toggled="OnThemeToggled" />
            </Grid>
        </Frame>
    </VerticalStackLayout>
</ContentPage>