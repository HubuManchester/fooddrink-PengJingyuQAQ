<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware"
             BackgroundColor="#F8F9FA">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame CornerRadius="10" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Camera Integration" FontSize="18" FontAttributes="Bold" />
                    <Button Text="Capture Image" Clicked="OnTakePhotoClicked" BackgroundColor="#E24933" TextColor="White" />
                    <Image x:Name="FoodPhoto" HeightRequest="150" Aspect="AspectFit" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="10" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. Geolocation" FontSize="18" FontAttributes="Bold" />
                    <Button Text="Fetch Coordinates" Clicked="OnLocationClicked" BackgroundColor="#007ACC" TextColor="White" />
                    <Label x:Name="LocationLabel" Text="Awaiting coordinates..." TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="10" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3. Text-to-Speech &amp; Vibration" FontSize="18" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Speak" Clicked="OnSpeakClicked" BackgroundColor="#28A745" TextColor="White" />
                        <Button Text="Stop" Clicked="OnStopSpeakClicked" BackgroundColor="#666666" TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="10" Padding="15" HasShadow="True" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="4. Flashlight" FontSize="18" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Turn On" Clicked="OnFlashlightOnClicked" BackgroundColor="#F1C40F" TextColor="Black" />
                        <Button Text="Turn Off" Clicked="OnFlashlightOffClicked" BackgroundColor="#333333" TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>