<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.AddItemPage"
             Title="Add Recipe"
             BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Recipe Details" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50" Margin="0,0,0,10"/>

            <Label Text="Name *" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" Placeholder="e.g. Classic Beef Burger" />

            <Label Text="Category *" FontAttributes="Bold" />
            <Entry x:Name="CategoryEntry" Placeholder="e.g. Main Course" />

            <Label Text="Calories (kcal) *" FontAttributes="Bold" />
            <Entry x:Name="CaloriesEntry" Placeholder="e.g. 650" Keyboard="Numeric" />

            <Label Text="Description" FontAttributes="Bold" />
            <Editor x:Name="DescriptionEditor" Placeholder="Enter full description here..." HeightRequest="80" />

            <Label Text="Allergy Note" FontAttributes="Bold" />
            <Entry x:Name="AllergyEntry" Placeholder="e.g. Contains Dairy, Gluten" />

            <Label Text="Tags" FontAttributes="Bold" />
            <Entry x:Name="TagsEntry" Placeholder="e.g. Fast Food, High Protein" />

            <Label Text="Image URL" FontAttributes="Bold" />
            <Entry x:Name="ImageUrlEntry" Placeholder="https://..." />

            <Button Text="Save Recipe" 
                    BackgroundColor="#4A148C" 
                    TextColor="White" 
                    CornerRadius="8" 
                    Margin="0,20,0,20"
                    Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>