<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="{Binding Name}"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="350" HorizontalOptions="Fill" />

            <VerticalStackLayout Padding="25" Spacing="15">
                <Label Text="{Binding Name}" FontSize="30" FontAttributes="Bold" TextColor="#1C1C1E" />
                <Label Text="{Binding CaloriesLabel}" FontSize="20" TextColor="#E24933" FontAttributes="Bold" />

                <HorizontalStackLayout Spacing="10" Margin="0,5,0,5">
                    <Button Text="🔊 Read Aloud" Clicked="OnReadAloudClicked" BackgroundColor="#2B0B98" TextColor="White" CornerRadius="8" HeightRequest="40" />
                    <Button Text="⏹ Stop" Clicked="OnStopSpeechClicked" BackgroundColor="#666666" TextColor="White" CornerRadius="8" HeightRequest="40" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0, 10" />

                <Label Text="Macronutrients" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" />
                <Label Text="{Binding MacroSummary}" FontSize="16" TextColor="#333333" />

                <Label Text="Allergy Note" FontSize="18" FontAttributes="Bold" TextColor="#D32F2F" Margin="0,10,0,0"/>
                <Label Text="{Binding AllergyNote}" FontSize="16" TextColor="#D32F2F" />

                <Label Text="Description" FontSize="18" FontAttributes="Bold" TextColor="#1C1C1E" Margin="0,10,0,0" />
                <Label Text="{Binding Description}" FontSize="16" TextColor="#666666" LineHeight="1.5" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>