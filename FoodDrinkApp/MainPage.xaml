<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.MainPage"
             Title="Nutritional Guide"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="Auto, *" Padding="15,20,15,0">

        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="0"
                Margin="0,0,0,15">
            <SearchBar x:Name="RecipeSearchBar" 
                       Placeholder="Search recipes, tags..." 
                       SearchButtonPressed="OnSearchButtonPressed"
                       BackgroundColor="Transparent"
                       SemanticProperties.Description="Search bar for finding specific food or drink items." />
        </Border>

        <CollectionView x:Name="RecipesCollectionView" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView Padding="0,0,0,16" 
                                 SemanticProperties.Description="{Binding AccessibleSummary}"
                                 SemanticProperties.Hint="Tap to view detailed nutritional information.">

                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="Transparent"
                                BackgroundColor="White"
                                Padding="0">

                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.06" Offset="0,4" Radius="12" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecipeCardTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="120, *">

                                <BoxView Grid.Column="0" Color="#EFEFEF" WidthRequest="120" HeightRequest="120" />

                                <Image Grid.Column="0" 
                                       Source="{Binding ImageUrl}" 
                                       Aspect="AspectFill"
                                       WidthRequest="120"
                                       HeightRequest="120" />

                                <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Padding="15">
                                    <Label Grid.Row="0"
                                           Text="{Binding Name}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#2C3E50" 
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />

                                    <Border Grid.Row="1" 
                                            StrokeShape="RoundRectangle 8" 
                                            Stroke="Transparent" 
                                            BackgroundColor="#E8F4FD" 
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            Padding="10,4"
                                            Margin="0,6,0,0">
                                        <Label Text="{Binding Category}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#0277BD" />
                                    </Border>

                                    <Label Grid.Row="2"
                                           Text="{Binding Calories, StringFormat='🔥 {0} kcal'}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           TextColor="#E74C3C" 
                                           HorizontalOptions="End"
                                           VerticalOptions="End" />
                                </Grid>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>